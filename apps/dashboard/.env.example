# Copy to apps/dashboard/.env.local (gitignored). On Vercel, set the same names under Project → Settings →
# Environment Variables.

# Supabase project URL: Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts sb_publishable_): safe in the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts sb_secret_): server code only. It bypasses row level security, so it must never get a
# NEXT_PUBLIC_ prefix or be imported by a client component.
SUPABASE_SECRET_KEY=
