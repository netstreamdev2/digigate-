# Copy to apps/gate/.env (gitignored) and fill in. Leave empty to run on local demo data only.
# Expo builds EXPO_PUBLIC_ variables into the app itself, so only values that are safe to ship belong here.
# For EAS builds, set the same names with `eas env:create`; .env is not uploaded.

# Supabase project URL: Dashboard → Project Settings → Data API.
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (starts sb_publishable_): Dashboard → Project Settings → API Keys.
# Safe in the app: row level security decides what a paired device can read and write.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the secret key (sb_secret_) here. It bypasses row level security.
