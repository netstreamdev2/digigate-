{
  "expo": {
    "name": "DigiGate",
    "slug": "digigate",
    "scheme": "digigate",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "../../packages/design/assets/identity/app-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.digigate.gate",
      "adaptiveIcon": {
        "backgroundColor": "#062C65",
        "foregroundImage": "../../packages/design/assets/identity/android-icon-foreground.png",
        "backgroundImage": "../../packages/design/assets/identity/android-icon-background.png",
        "monochromeImage": "../../packages/design/assets/identity/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "../../packages/design/assets/identity/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 33
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9706fd7a-960f-4e1b-9587-f0e96e9a8282"
      }
    },
    "owner": "netstreamdevtests-team"
  }
}
