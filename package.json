{
  "name": "digigate",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gate": "pnpm --filter gate",
    "dashboard": "pnpm --filter dashboard",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:db": "node supabase/tests/database.test.mjs",
    "test:reports": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./supabase/tests/gate-simulator/resolve-ts.mjs supabase/tests/report-files.test.ts",
    "simulate": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./supabase/tests/gate-simulator/resolve-ts.mjs supabase/tests/gate-simulator/simulate.ts",
    "simulate:erase": "pnpm simulate --erase"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "pdf-lib": "1.17.1"
  }
}
